# copy this to .env and fill in your own values
# .env is git-ignored — this example file is the only one that gets committed

# server
PORT=3000

# mongodb — use the standard (non-SRV) connection string
# SRV queries fail on some networks (see docs/TROUBLESHOOTING.md)
MONGO_URL=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/hackjudge

# auth — any long random string works, e.g. `openssl rand -hex 32`
JWT_SECRET=

# frontend dev server, for CORS
CLIENT_URL=http://localhost:5173
